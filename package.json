{
  "name": "student-hub",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "dev:stage": "vite --mode stage",
    "build": "vite build",
    "build:prod": "vite build --mode production",
    "serve": "vite preview",
    "lint": "eslint --ext .js,.vue --ignore-path .gitignore --fix src",
    "firebase:emulator": "firebase emulators:start --import ./firestore-export"
  },
  "dependencies": {
    "@vitejs/plugin-vue": "^1.6.1",
    "core-js": "^3.6.5",
    "dotenv": "^10.0.0",
    "eslint-plugin-cypress": "^2.12.1",
    "firebase": "^9.0.1",
    "vite": "^2.5.4",
    "vue": "^3.2.20",
    "vue-router": "^4.0.12",
    "vue3-markdown-it": "^1.0.9",
    "vuex": "^4.0.2"
  },
  "devDependencies": {
    "ansi-regex": ">=5.0.1",
    "babel-eslint": "^10.1.0",
    "cypress": "^9.0.0",
    "eslint": "^8.57.0",
    "eslint-plugin-vue": "^8.7.1",
    "firebase-admin": "^10.2.0",
    "googleapis": "^100.0.0",
    "jest": "^28.1.0",
    "lint-staged": "^9.5.0",
    "prettier": "^2.2.1"
  },
  "gitHooks": {
    "pre-commit": "lint-staged"
  },
  "lint-staged": {
    "*.{js,jsx,vue}": [
      "vue-cli-service lint",
      "git add"
    ]
  }
}
